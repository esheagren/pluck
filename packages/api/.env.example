# Pull the real values with: vercel env pull .env.local --environment=production --yes

# Neon Postgres — injected by the Vercel Neon integration
DATABASE_URL=

# Vercel Blob (card images) — injected when a Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# Google OAuth Web client ID(s), comma-separated. ID tokens from the webapp and
# extension are verified against these.
GOOGLE_CLIENT_IDS=

# LLM providers
CLAUDE_API_KEY=
GEMINI_API_KEY=
